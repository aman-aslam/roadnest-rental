# PostgreSQL. Create the database before running migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roadnest?schema=public"

# API
API_PORT=4000
API_ORIGIN="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false

# Seeded admin user (change this before first seed in any shared environment)
ADMIN_NAME="Shop Administrator"
ADMIN_EMAIL="admin@roadnest.local"
ADMIN_PASSWORD="ChangeMeNow!2026"

# Persistent vehicle image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Private persistent storage for customer identity documents and handover photos
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# AI (server-side only; never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Shop branding / contact
NEXT_PUBLIC_SHOP_NAME="RoadNest Rentals"
NEXT_PUBLIC_SHOP_CITY="Your City"
NEXT_PUBLIC_SHOP_PHONE="+91 90000 00000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Razorpay (leave blank to run in cash/manual-payment mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional notification integrations (not required for local development)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMS_PROVIDER_API_KEY=""
GOOGLE_MAPS_API_KEY=""
