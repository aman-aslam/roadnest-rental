# Browser requests use the same-origin Next.js proxy.
# API_ORIGIN is read only by the server-side proxy handlers.
NEXT_PUBLIC_API_URL=/api
API_ORIGIN=http://localhost:4000
# Optional: direct multipart uploads. Leave unset locally to use the local proxy.
# Production defaults to https://roadnest-api.onrender.com/api.
# NEXT_PUBLIC_UPLOAD_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SHOP_NAME=RoadNest Rentals
NEXT_PUBLIC_SHOP_CITY=Bangalore
NEXT_PUBLIC_SHOP_PHONE=+91 9876543212
